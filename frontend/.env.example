# ─────────────────────────────────────────────────────────────────────────────
# ResQnet - Frontend environment variables
# Copy this file to  frontend/.env  (never commit .env).
# Values are SERVER ROOTS. Do NOT add "/api"; the app adds it (see src/config.ts).
# If a variable is missing, the default shown below is used.
# ─────────────────────────────────────────────────────────────────────────────

# Member 1 - Auth, users, roles, organisations, audit
VITE_API_URL=http://localhost:5016

# Member 4 - AI services (chat, case review, forecasting)
VITE_AI_API_URL=http://localhost:5157

# Member 5 - Resources, shelters, map
VITE_RESOURCES_API_URL=http://localhost:5126

# Member 6 - Volunteers, donors, campaigns, notifications
VITE_VOLUNTEERS_API_URL=http://localhost:5006

# Core API - citizen requests + coordination (to be built, reserved port)
VITE_CORE_API_URL=http://localhost:5200
